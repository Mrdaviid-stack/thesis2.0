@layout.online.app({ title: "Account" })
    @slot('meta')
        <meta name="description" content="A welcome page made with EdgeJS">
    @endslot
    <button class="nav-link active" id="v-pills-home-tab" data-bs-toggle="pill" data-bs-target="#v-pills-home" type="button" role="tab" aria-controls="v-pills-home" aria-selected="true">Home</button>
    <main class="row mt-5">
        <div class="row">
            <div class="col-12 col-lg-4">
                <ul class="list-group">
                    <li class="list-group-item py-3">
                        <a class="nav-link" href="/my-account">DASHBOARD</a>
                    </li>
                    <li class="list-group-item py-3 bg-danger text-white">
                        <a class="nav-link" href="/my-account/orders">ORDERS</a>
                    </li>
                    <li class="list-group-item py-3">
                        <a class="nav-link" href="/my-account/details">ACCOUNT DETAILS</a>
                    </li>
                    <li class="list-group-item py-3">LOG OUT</li>
                </ul>
            </div>
            <div class="col-12 col-lg-8" x-data="myOrder({
                orders: {{JSON.stringify(orders)}}
            })">
                @if(orders.length < 1)
          
                    <div class="border-top border-5 border-warning px-3 py-3 bg-secondary">
                        <p class="mb-0">No order has been made yet.</p>
                    </div>
    
                @else
                    <ul class="list-group">
                        <template x-for="order in orders">
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div class="d-flex">
                                    <img :src="order.productImage" width="150" :alt="order.productName" />
                                    <div class="lh-1">
                                        <div class="d-flex justify-content-start gap-3">
                                            <strong x-text="order.productName"></strong>
                                            <div>
                                                <a class="" type="button" data-bs-toggle="collapse" :href="`#${order.transactionInvoice}`" aria-expanded="false" :aria-controls="`${order.transactionInvoice}`">
                                                    View Details
                                                </a>
                                                <div class="collapse" :id="`${order.transactionInvoice}`">
                                                    <div class="card card-body">
                                                        <small class="mb-0"><strong>Invoice:</strong> <span x-text="order.transactionInvoice"></span></small>
                                                        <p class="mb-0"><strong>Color:</strong> <span x-text="order.productColor"></span></p>
                                                        <p class="mb-0"><strong>Storage:</strong> <span x-text="order.productStorage"></span></p>
                                                        <p class="mb-0"><strong>Quantity:</strong> <span x-text="order.quantity"></span></p>
                                                        <p class="mb-0"><strong>Amount:</strong> <span x-text="order.price.toLocaleString()"></span></p>
                                                        <p class="mb-0"><strong>Downpayment:</strong> <span x-text="order.downpayment.toLocaleString()"></span></p>
                                                        <p class="mb-0"><strong>Balance:</strong> <span x-text="order.balance.toLocaleString()"></span></p>
                                                        <p class="mb-0"><strong>Rider:</strong> <span x-text="order.rider"></span></p>
                                                        <p class="mb-0"><strong>Order Date:</strong> <span x-text="order.orderDate"></span></p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <template x-if="order.status !== 'request_cancel'">
                                        <button class="btn btn-warning" disabled x-text="order.deliveryStatus.toUpperCase()"></button>
                                    </template>
                                    <template x-if="order.deliveryStatus === 'pending'">
                                        <button class="btn btn-danger" :disabled="order.status === 'request_cancel'" @click="onCancelOrder(order.transactionId)">CANCEL ORDER</button>
                                    </template>
                                    <template x-if="order.deliveryStatus === 'delivered'">
                                        <button :disabled="order.status === 'returned'" class="btn btn-outline-danger btn-sm" @click="activeReceiptOrder = order; showModal = true">
                                            <template x-if="order.status === 'returned'">
                                                <span class="text-success">EXCHANGE REQUESTED</span>
                                            </template>
                                            <template x-if="order.status !== 'returned'">
                                                <span>REQUEST EXCHANGE</span>
                                            </template>
                                        </button>
                                    </template>
                                </div>
                            </li>
                        </template>
                    </ul>
                    <div 
                        x-show="showModal" 
                        x-transition.opacity 
                        @click.outside="closeModal" 
                        class="modal fade" 
                        :class="{'show d-block': showModal}" 
                        style="background-color: rgba(0, 0, 0, 0.5);"
                    >
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h1 class="modal-title fs-5">Product Replacement</h1>
                                    <button type="button" class="btn-close" @click="closeModal"></button>
                                </div>
                                <div class="modal-body" >
                                    <div class="p-4">
                                        <p class="text-center">
                                            The filing of replacement will be subjected to review by BSD International, any noticed physical damage such as dents or cracks may be subjected to rejection of the request. Please wait 1-3 days before it was accepted.
                                        </p>
                                    </div>
                                    <div class="row">
                                        <div class="col-4">
                                            <div class="mb-2">
                                                <label>Customer Name</label>
                                                <input class="form-control" x-model="activeReceiptOrder.customerName" readonly />
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="mb-2">
                                                <label>Product</label>
                                                <input class="form-control" x-model="activeReceiptOrder.productName" readonly />
                                            </div>
                                        </div>  
                                        <div class="col-4">
                                            <div class="mb-2">
                                                <label>Invoice</label>
                                                <input class="form-control" x-model="activeReceiptOrder.transactionInvoice" readonly />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6">
                                            <label>Reason of replacement</label>
                                            <select x-model="replacementReason" class="form-select">
                                                <option value="" hidden>Select Reason</option>
                                                <option value="Faulty Camera">Faulty Camera</option>
                                                <option value="Software Glitching / Bug">Software Glitching / Bug</option>
                                                <option value="Wrong Item">Wrong Item</option>
                                                <option value="Damaged Item">Damaged Item</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </div>
                                        <div class="col-6">
                                            <label>Short Description</label>
                                            <input class="form-control" type="text" placeholder="Short description of the reason" x-model="replacementDescription" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12">
                                            <label>Attach Proof</label>
                                            <input @change="onUploadProof($event)" class="form-control form-control-lg" type="file" accept="image/*,video/*" />
                                        </div>
                                    </div>
                                    <button class="btn btn-info btn-lg mt-3 w-100" @click="onReturn(activeReceiptOrder.transactionId)">SUBMIT</button>
                                </div>
                            </div>
                        </div>
                    </div>

                @end
            </div>
        </div>
    </main>
@end